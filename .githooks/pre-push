#!/usr/bin/env bash
set -euo pipefail

integration_path=$(git config --get spws.integrationWorktree || true)
current_path=$(git rev-parse --show-toplevel 2>/dev/null || true)
current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

canonical_path() {
  (cd "$1" 2>/dev/null && pwd -P)
}

reject=0
while read -r local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  if [[ -z "$integration_path" ]] \
      || [[ "$(canonical_path "$current_path")" != "$(canonical_path "$integration_path")" ]] \
      || [[ "$current_branch" != "main" && "$current_branch" != "integration/main" ]]; then
    echo "ERROR: Only the registered integration checkout may push main." >&2
    echo "Current checkout: ${current_path:-unknown}" >&2
    echo "Current branch: ${current_branch:-detached}" >&2
    echo "Registered integration checkout: ${integration_path:-not configured}" >&2
    reject=1
    continue
  fi
  if [[ "$local_ref" != "refs/heads/$current_branch" ]]; then
    echo "ERROR: main must be updated from the current integration branch." >&2
    echo "Use: git push origin HEAD:main" >&2
    reject=1
  fi
done

exit "$reject"
